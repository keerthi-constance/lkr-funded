    "escrow/EscrowDatum": {
      "title": "EscrowDatum",
      "description": "Locked at the escrow script address for every donation. One UTXO per\n donation — never merged with others, so each milestone payout/refund\n spends exactly the donation it belongs to.",
      "anyOf": [
        {
          "title": "EscrowDatum",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "donor",
              "description": "Key hash of the donor's own wallet — the only party who can reclaim\n funds via `Refund`.",
              "$ref": "#/definitions/aiken~1crypto~1VerificationKeyHash"
            },
            {
              "title": "student",
              "description": "Key hash of the student/project payout address — where `Release`\n sends the locked funds once a milestone is verified.",
              "$ref": "#/definitions/aiken~1crypto~1VerificationKeyHash"
            },
            {
              "title": "project_id",
              "description": "Off-chain project identifier (its slug), carried on-chain purely so a\n release/refund transaction can be tied back to the right project row\n in the platform's database when indexing chain history.",
              "$ref": "#/definitions/ByteArray"
            },
            {
              "title": "amount_lovelace",
              "description": "Lovelace amount locked by this donation, checked against the actual\n UTXO value at spend time — not trusted on its own.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "rs_amount",
              "description": "The Rs amount the donor actually typed into the donation form. EDUF\n minting (see eduf_mint.ak) is pegged to this at 10 EDUF per Rs.",
              "$ref": "#/definitions/Int"
            }
          ]
        }
      ]
    },
    "escrow/EscrowRedeemer": {
      "title": "EscrowRedeemer",
      "anyOf": [
        {
          "title": "Release",
          "description": "Milestone verified off-chain by the platform admin/university — pay\n the locked funds to `datum.student`. Requires the admin key's\n signature; the donor cannot trigger this themselves.",
          "dataType": "constructor",
          "index": 0,
          "fields": []
        },
        {
          "title": "Refund",
          "description": "Donor reclaims funds (e.g. project cancelled or milestone rejected).\n Requires the donor's own signature — nobody else can trigger this.",
          "dataType": "constructor",
          "index": 1,
          "fields": []
        }
      ]
    }
