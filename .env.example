MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# Encrypts/signs the login session cookie — must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# PayHere sandbox merchant credentials — https://sandbox.payhere.lk (create a
# free sandbox account, merchant secret is under Integrations > Add Domain/App).
# Never commit real values here; PAYHERE_MERCHANT_SECRET must never reach the client.
PAYHERE_MERCHANT_ID=<your-sandbox-merchant-id>
PAYHERE_MERCHANT_SECRET=<your-sandbox-merchant-secret>
# "true" posts to sandbox.payhere.lk, "false" posts to the live www.payhere.lk endpoint.
PAYHERE_SANDBOX_MODE=true
# Must be a publicly reachable HTTPS URL — PayHere's servers POST here directly,
# so localhost only works behind a tunnel (ngrok/Cloudflare Tunnel) during dev.
PAYHERE_NOTIFY_URL=https://<your-public-host>/api/payhere/notify
PAYHERE_RETURN_URL=https://<your-public-host>/donate/return
PAYHERE_CANCEL_URL=https://<your-public-host>/donate/cancel

# Hyperledger Fabric — see fabric/network/README.md for how to stand up the
# network and where these files come from (deploy-network.sh generates them).
# The app backend submits transactions as BOTH orgs (Org1 = platform admin
# actions, Org2 = university verifier actions) — a prototype simplification;
# a real deployment would give the university its own backend + identity.
# Requires the Fabric network to be reachable from wherever this app runs —
# for local dev that's fine (both on localhost), but the Vercel deployment
# cannot reach a network running on your own machine.
FABRIC_CHANNEL_NAME=fundedchannel
FABRIC_CHAINCODE_NAME=funded

FABRIC_ORG1_MSP_ID=Org1MSP
FABRIC_ORG1_PEER_ENDPOINT=localhost:7051
FABRIC_ORG1_PEER_HOST_ALIAS=peer0.org1.example.com
FABRIC_ORG1_TLS_CERT_PATH=<fabric-samples>/test-network/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt
FABRIC_ORG1_CERT_PATH=<fabric-samples>/test-network/organizations/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/signcerts/cert.pem
FABRIC_ORG1_KEY_PATH=<fabric-samples>/test-network/organizations/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/keystore/<generated-file>

FABRIC_ORG2_MSP_ID=Org2MSP
FABRIC_ORG2_PEER_ENDPOINT=localhost:9051
FABRIC_ORG2_PEER_HOST_ALIAS=peer0.org2.example.com
FABRIC_ORG2_TLS_CERT_PATH=<fabric-samples>/test-network/organizations/peerOrganizations/org2.example.com/peers/peer0.org2.example.com/tls/ca.crt
FABRIC_ORG2_CERT_PATH=<fabric-samples>/test-network/organizations/peerOrganizations/org2.example.com/users/User1@org2.example.com/msp/signcerts/cert.pem
FABRIC_ORG2_KEY_PATH=<fabric-samples>/test-network/organizations/peerOrganizations/org2.example.com/users/User1@org2.example.com/msp/keystore/<generated-file>

# Gmail App Password — milestone disbursement / auction reward payout
# emails are sent from this Gmail account (see server/mailer.ts). Generate
# one at myaccount.google.com > Security > 2-Step Verification > App
# Passwords; regular Gmail passwords are rejected for SMTP. Named
# SMTP_AUTH_CODE, not SMTP_PASS/SMTP_PASSWORD — see server/mailer.ts.
SMTP_USER=<your-gmail-address>
SMTP_AUTH_CODE=<your-gmail-app-password>

# Groq (OpenAI-compatible chat completions, no SDK — see server/ai.ts) powers
# the investor recommendation explanations and the investor-only RAG
# assistant. Get a free key at https://console.groq.com/keys.
GROQ_API_KEY=<your-groq-api-key>
# See https://console.groq.com/docs/models for currently available models —
# Groq's lineup changes over time; check what's active for your key with
# GET https://api.groq.com/openai/v1/models if this one 404s.
GROQ_MODEL=openai/gpt-oss-120b
