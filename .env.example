MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# Cardano preprod testnet treasury (platform e-wallet). Get a free preprod
# project id at https://blockfrost.io — never commit real values here.
BLOCKFROST_PROJECT_ID=preprod<your-blockfrost-project-id>
# 24-word seed phrase for a preprod wallet you control (e.g. create one in
# Eternl set to the Preprod network, fund it from https://docs.cardano.org/cardano-testnets/tools/faucet).
# This wallet is the platform treasury — never share this phrase, never use a mainnet wallet's phrase here.
TREASURY_MNEMONIC=word1 word2 word3 ... word24
